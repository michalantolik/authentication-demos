@page "/StatusCode"

@using Microsoft.AspNetCore.Components

@*
    Displays information about an HTTP status code.

    Used by UseStatusCodePagesWithReExecute when the application
    returns an HTTP status code.
*@

<PageTitle>HTTP Error</PageTitle>

<h1>HTTP Error</h1>

@if (Code.HasValue)
{
    <h2>Status code: @Code</h2>
}

<p>
    The request could not be completed.
</p>

<h2>
    <a href="/">Start the application again →</a>
</h2>

@code {

    /// <summary>
    /// The HTTP status code from the query string.
    /// </summary>
    [SupplyParameterFromQuery(Name = "code")]
    private int? Code { get; set; }

}
